# Desenvolvimento local. Na Vercel, configure DEBUG=False e SECRET_KEY nas variáveis do projeto.
DEBUG=True
SECRET_KEY=chave-local-apenas
# PostgreSQL gerenciado (necessário em produção; SQLite não persiste na Vercel)
# DATABASE_URL=postgresql://user:senha@host/db?sslmode=require
# ALLOWED_HOSTS=.vercel.app,seu-dominio.com
# CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://seu-dominio.com
